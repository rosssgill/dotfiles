  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "{{colors.magenta.default.hex}}" } },
    { "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value"],
      "settings": { "foreground": "{{colors.cyan.default.hex}}" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw"],
      "settings": { "foreground": "{{colors.green.default.hex}}" } },
    { "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "{{colors.cyan.default.hex}}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"],
      "settings": { "foreground": "{{colors.yellow.default.hex}}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "{{colors.blue.default.hex}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "{{colors.yellow.default.hex}}" } },
    { "scope": ["variable", "meta.definition.variable"],
      "settings": { "foreground": "{{colors.on_surface.default.hex}}" } },
    { "scope": ["variable.parameter"],
      "settings": { "foreground": "{{colors.on_red_container.default.hex}}" } },
    { "scope": ["variable.language", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name", "variable.other.property"],
      "settings": { "foreground": "{{colors.red.default.hex}}" } },
    { "scope": ["entity.name.tag"],
      "settings": { "foreground": "{{colors.red.default.hex}}" } },
    { "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "{{colors.yellow.default.hex}}" } },
    { "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "{{colors.tertiary.default.hex}}" } },
    { "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "{{colors.blue.default.hex}}" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{colors.green.default.hex}}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{colors.red.default.hex}}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{colors.yellow.default.hex}}" } },
    { "scope": ["invalid"], "settings": { "foreground": "{{colors.error.default.hex}}" } }
  ]
}
